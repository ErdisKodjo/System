# EditorConfig for AfriOS
# https://editorconfig.org

root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{c,cpp,cc,h,hpp}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_style = space
indent_size = 4

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 8

[CMakeLists.txt]
indent_style = space
indent_size = 2

[BUILD.gn]
indent_style = space
indent_size = 2

[Android.bp]
indent_style = space
indent_size = 4
