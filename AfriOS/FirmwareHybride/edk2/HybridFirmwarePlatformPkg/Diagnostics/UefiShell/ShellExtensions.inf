[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ShellExtensions
  FILE_GUID                      = C3647058-1425-4F80-9102-132435465768
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = ShellExtensionsEntryPoint

[Sources]
  ShellExtensions.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ShellPkg/ShellPkg.dec
  HybridFirmwarePlatformPkg/HybridFirmwarePlatformPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiLib
  DebugLib
  MemoryAllocationLib
  BaseMemoryLib
  PrintLib
  ShellLib
  HiiLib

[Protocols]
  gEfiShellDynamicCommandProtocolGuid
  gEfiShellParametersProtocolGuid
  gEfiPciIoProtocolGuid
  gEfiSimpleFileSystemProtocolGuid

[Guids]
  # Consommation du GUID promu dans le .dec (étape P2). Le handler
  # afri_slot lit la variable NVRAM "AfriBootInfo" via ce GUID, qui doit
  # matcher celui utilisé par ABSlotManager.c pour l'écriture.
  gAfriBootInfoGuid

[Depex]
  TRUE
