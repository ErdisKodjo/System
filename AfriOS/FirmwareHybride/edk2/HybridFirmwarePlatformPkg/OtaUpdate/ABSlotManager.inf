##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = AbSlotManagerLib
  FILE_GUID                      = 81920314-2536-4B4C-5D6E-7F8091021324
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = AbSlotManagerLib

[Sources]
  ABSlotManager.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  HybridFirmwarePlatformPkg/HybridFirmwarePlatformPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  UefiRuntimeServicesTableLib
  UefiBootServicesTableLib
  UefiLib
  DebugLib

[Guids]
  # Consommation du GUID promu dans le .dec (étape P2). Le linker résout
  # gAfriBootInfoGuid depuis la bibliothèque auto-générée du package ;
  # aucun .c ne définit le GUID localement.
  gAfriBootInfoGuid
