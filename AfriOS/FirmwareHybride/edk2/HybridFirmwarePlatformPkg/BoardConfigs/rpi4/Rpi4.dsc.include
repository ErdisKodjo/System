## @file
# Board-specific overrides for Raspberry Pi 4 (ARM64, Cortex-A72).
#
# This file is included by HybridFirmwarePlatformPkg.dsc when BOARD_CONFIG=Rpi4.
# It overrides PcdFdtBaseAddress to the address where the RPi4 firmware (start4.elf)
# loads the Device Tree Blob passed to UEFI.
#
# Raspberry Pi 4 specifics:
#   - SoC        : BCM2711 (4x Cortex-A72 @ 1.5 GHz)
#   - RAM        : 1/2/4/8 GB depending on SKU
#   - FDT base   : 0x01000000 (start4.elf loads FDT here before jumping to UEFI)
#   - Boot mode  : SD card (FAT32 boot partition), firmware reads config.txt
#   - ACPI       : NOT available (Device Tree is the only description backend)
#
# Build:
#   build -p HybridFirmwarePlatformPkg.dsc -a AARCH64 -t GCC5 \
#          -D BOARD_CONFIG=Rpi4
#
# Copyright (c) 2026, AfriOS. All rights reserved.
##

[Defines]
  # Force the Device Tree backend — RPi4 has no ACPI tables.
  DEFINE PCD_PREFER_DEVICE_TREE_DEFAULT  = TRUE

[PcdsFixedAtBuild]
  # Adresse où start4.elf charge le FDT avant de sauter dans UEFI.
  # Voir : https://www.raspberrypi.com/documentation/computers/raspberry-pi.html
  gHybridFirmwarePlatformPkgTokenSpaceGuid.PcdFdtBaseAddress|0x01000000

  # RPi4 : pas de tables firmware ACPI, on force DeviceTree.
  gHybridFirmwarePlatformPkgTokenSpaceGuid.PcdPreferDeviceTree|TRUE
  gHybridFirmwarePlatformPkgTokenSpaceGuid.PcdPlatformHasNoFirmwareTables|FALSE

  # RPi4 est typiquement alimenté par secteur (PoE HAT possible).
  gHybridFirmwarePlatformPkgTokenSpaceGuid.PcdPowerSourceType|0
